<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form_inherit" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_subscription_contracts"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-refresh"
                    invisible="not subscription_contract_count"
                    groups="alfo_subscription_core.group_subscription_user"
                >
                    <field
                        name="subscription_contract_count"
                        widget="statinfo"
                        string="Subscriptions"
                    />
                </button>
            </div>
            <!-- Both Confirm buttons show the subscription changes before confirming -->
            <xpath expr="//button[@id='action_confirm']" position="attributes">
                <attribute
                    name="context"
                >{'validate_analytic': True, 'subscription_preview': True}</attribute>
            </xpath>
            <xpath
                expr="//button[@name='action_confirm'][not(@id)]"
                position="attributes"
            >
                <attribute
                    name="context"
                >{'validate_analytic': True, 'subscription_preview': True}</attribute>
            </xpath>
            <!-- Free trial lines in green -->
            <xpath expr="//field[@name='order_line']/list" position="attributes">
                <attribute name="decoration-success">subscription_trial</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list" position="inside">
                <field name="subscription_trial" column_invisible="True" />
            </xpath>
        </field>
    </record>
</odoo>
