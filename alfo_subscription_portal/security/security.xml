<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Portal users only see the customer subscriptions of their company -->
    <record id="subscription_contract_rule_portal" model="ir.rule">
        <field name="name">Subscription contract: portal customer</field>
        <field
            name="model_id"
            ref="alfo_subscription_core.model_subscription_contract"
        />
        <field
            name="domain_force"
        >[('contract_type', '=', 'sale'), ('partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]" />
    </record>

    <record id="subscription_contract_line_rule_portal" model="ir.rule">
        <field name="name">Subscription contract line: portal customer</field>
        <field
            name="model_id"
            ref="alfo_subscription_core.model_subscription_contract_line"
        />
        <field
            name="domain_force"
        >[('contract_id.contract_type', '=', 'sale'), ('contract_id.partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]" />
    </record>
</odoo>
