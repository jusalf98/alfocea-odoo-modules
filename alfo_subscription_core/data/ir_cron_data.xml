<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_subscription_update_states" model="ir.cron">
        <field name="name">Subscriptions: update trial and expired states</field>
        <field name="model_id" ref="model_subscription_contract" />
        <field name="state">code</field>
        <field name="code">model._cron_update_states()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_subscription_send_reminders" model="ir.cron">
        <field name="name">Subscriptions: send reminder emails</field>
        <field name="model_id" ref="model_subscription_contract" />
        <field name="state">code</field>
        <field name="code">model._cron_send_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>
</odoo>
