<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="mail_template_subscription_renewal_reminder" model="mail.template">
        <field name="name">Subscription: renewal reminder</field>
        <field name="model_id" ref="model_subscription_contract" />
        <field
            name="subject"
        >Your subscription {{ object.name }} will be renewed soon</field>
        <field
            name="email_from"
        >{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True" />
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p>Hello <t t-out="object.partner_id.name or ''" />,</p>
                <p>
                    Your subscription <strong t-out="object.name or ''" />
                    (<t t-out="object.plan_id.name or ''" />) will be renewed on
                    <strong t-out="format_date(object.next_invoice_date)" />
                    for <strong
                    t-out="format_amount(object.amount_total, object.currency_id)"
                />.
                </p>
                <p>If you have any questions, just reply to this email.</p>
            </div>
        </field>
    </record>

    <record id="mail_template_subscription_trial_reminder" model="mail.template">
        <field name="name">Subscription: end of the free trial</field>
        <field name="model_id" ref="model_subscription_contract" />
        <field name="subject">Your free trial of {{ object.name }} ends soon</field>
        <field
            name="email_from"
        >{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True" />
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p>Hello <t t-out="object.partner_id.name or ''" />,</p>
                <p>
                    The free trial of your subscription
                    <strong t-out="object.name or ''" /> ends on
                    <strong t-out="format_date(object.trial_end_date)" />.
                    From then on, it will be billed
                    <t t-out="object.plan_id.billing_label or ''" />:
                    <strong
                    t-out="format_amount(object.amount_total, object.currency_id)"
                />.
                </p>
                <p>If you have any questions, just reply to this email.</p>
            </div>
        </field>
    </record>

    <record id="mail_template_subscription_expiry_reminder" model="mail.template">
        <field name="name">Subscription: end of the subscription</field>
        <field name="model_id" ref="model_subscription_contract" />
        <field name="subject">Your subscription {{ object.name }} ends soon</field>
        <field
            name="email_from"
        >{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True" />
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p>Hello <t t-out="object.partner_id.name or ''" />,</p>
                <p>
                    Your subscription <strong t-out="object.name or ''" />
                    ends on <strong t-out="format_date(object.date_end)" />.
                </p>
                <p>If you want to keep it, just reply to this email.</p>
            </div>
        </field>
    </record>
</odoo>
