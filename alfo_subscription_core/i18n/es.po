#. module: alfo_subscription_core
#: model:mail.template,body_html:alfo_subscription_core.mail_template_subscription_trial_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>Hello <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"                <p>\n"
"                    The free trial of your subscription\n"
"                    <strong t-out=\"object.name or ''\"/> ends on\n"
"                    <strong t-out=\"format_date(object.trial_end_date)\"/>.\n"
"                    From then on, it will be billed\n"
"                    <t t-out=\"object.plan_id.billing_label or ''\"/>:\n"
"                    <strong t-out=\"format_amount(object.amount_total, object.currency_id)\"/>.\n"
"                </p>\n"
"                <p>If you have any questions, just reply to this email.</p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>Hola <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"                <p>\n"
"                    La prueba gratuita de su suscripción\n"
"                    <strong t-out=\"object.name or ''\"/> termina el\n"
"                    <strong t-out=\"format_date(object.trial_end_date)\"/>.\n"
"                    A partir de entonces se facturará\n"
"                    <t t-out=\"object.plan_id.billing_label or ''\"/>:\n"
"                    <strong t-out=\"format_amount(object.amount_total, object.currency_id)\"/>.\n"
"                </p>\n"
"                <p>Si tiene alguna pregunta, responda a este correo.</p>\n"
"            </div>\n"
"        "

#. module: alfo_subscription_core
#: model:mail.template,body_html:alfo_subscription_core.mail_template_subscription_renewal_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>Hello <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"                <p>\n"
"                    Your subscription <strong t-out=\"object.name or ''\"/>\n"
"                    (<t t-out=\"object.plan_id.name or ''\"/>) will be renewed on\n"
"                    <strong t-out=\"format_date(object.next_invoice_date)\"/>\n"
"                    for <strong t-out=\"format_amount(object.amount_total, object.currency_id)\"/>.\n"
"                </p>\n"
"                <p>If you have any questions, just reply to this email.</p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>Hola <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"                <p>\n"
"                    Su suscripción <strong t-out=\"object.name or ''\"/>\n"
"                    (<t t-out=\"object.plan_id.name or ''\"/>) se renovará el\n"
"                    <strong t-out=\"format_date(object.next_invoice_date)\"/>\n"
"                    por <strong t-out=\"format_amount(object.amount_total, object.currency_id)\"/>.\n"
"                </p>\n"
"                <p>Si tiene alguna pregunta, responda a este correo.</p>\n"
"            </div>\n"
"        "

#. module: alfo_subscription_core
#: model:mail.template,body_html:alfo_subscription_core.mail_template_subscription_expiry_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>Hello <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"                <p>\n"
"                    Your subscription <strong t-out=\"object.name or ''\"/>\n"
"                    ends on <strong t-out=\"format_date(object.date_end)\"/>.\n"
"                </p>\n"
"                <p>If you want to keep it, just reply to this email.</p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>Hola <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"                <p>\n"
"                    Su suscripción <strong t-out=\"object.name or ''\"/>\n"
"                    termina el <strong t-out=\"format_date(object.date_end)\"/>.\n"
"                </p>\n"
"                <p>Si quiere mantenerla, responda a este correo.</p>\n"
"            </div>\n"
"        "

