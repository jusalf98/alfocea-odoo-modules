<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="subscription_change_plan_wizard_view_form" model="ir.ui.view">
        <field name="name">subscription.change.plan.wizard.form</field>
        <field name="model">subscription.change.plan.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="contract_id" invisible="1" />
                <field name="company_id" invisible="1" />
                <group>
                    <field name="current_plan_id" />
                    <field name="plan_id" options="{'no_create': True}" />
                    <field name="note" placeholder="Details for the chatter..." />
                </group>
                <div class="text-muted">
                    The current period is kept: the next invoice date does not change
                    and the following renewals use the new plan.
                </div>
                <footer>
                    <button
                        name="action_apply"
                        type="object"
                        string="Change Plan"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button special="cancel" string="Discard" data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
