<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_report_subscription_plan" model="ir.actions.report">
        <field name="name">Subscription Plan</field>
        <field name="model">subscription.plan</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >alfo_subscription_core.report_subscription_plan</field>
        <field
            name="report_file"
        >alfo_subscription_core.report_subscription_plan</field>
        <field
            name="print_report_name"
        >'Plan - %s' % (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="model_subscription_plan" />
        <field name="binding_type">report</field>
    </record>
</odoo>
