<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_subscription" model="ir.module.category">
        <field name="name">Subscriptions</field>
        <field name="parent_id" ref="base.module_category_sales" />
        <field name="sequence">20</field>
    </record>

    <record id="group_subscription_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_subscription" />
    </record>

    <record id="group_subscription_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_subscription" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_subscription_user'))]"
        />
        <!-- The Odoo administrator gets full access on install -->
        <field
            name="users"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"
        />
    </record>

    <data noupdate="1">
        <record id="subscription_plan_rule_company" model="ir.rule">
            <field name="name">Subscription plan: multi-company</field>
            <field name="model_id" ref="model_subscription_plan" />
            <field
                name="domain_force"
            >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="subscription_contract_rule_company" model="ir.rule">
            <field name="name">Subscription contract: multi-company</field>
            <field name="model_id" ref="model_subscription_contract" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="subscription_contract_line_rule_company" model="ir.rule">
            <field name="name">Subscription contract line: multi-company</field>
            <field name="model_id" ref="model_subscription_contract_line" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
