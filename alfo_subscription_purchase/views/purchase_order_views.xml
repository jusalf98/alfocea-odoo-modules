<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purchase_order_form_inherit" model="ir.ui.view">
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_subscription_contracts"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-refresh"
                    invisible="not subscription_contract_count"
                    groups="alfo_subscription_core.group_subscription_user"
                >
                    <field
                        name="subscription_contract_count"
                        widget="statinfo"
                        string="Subscriptions"
                    />
                </button>
            </div>
            <!-- Both Confirm buttons show the subscription changes before confirming -->
            <xpath expr="//button[@id='bid_confirm']" position="attributes">
                <attribute
                    name="context"
                >{'validate_analytic': True, 'subscription_preview': True}</attribute>
            </xpath>
            <xpath expr="//button[@id='draft_confirm']" position="attributes">
                <attribute
                    name="context"
                >{'validate_analytic': True, 'subscription_preview': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
